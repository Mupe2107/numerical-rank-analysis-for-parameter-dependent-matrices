# ПРИМЕРИ
# ============================================================

if __name__ == '__main__':
    import os
    import matplotlib
    matplotlib.use('Agg')
    os.makedirs('slike', exist_ok=True)

    # 1) Реалан параметар: M = [[1, p], [p̄, 1]], λ = (1 ± |p|)².
    #    Гране се секу у p = 0 (k' = 0), ранг пада са 2 на 1 у p = ±1.
    analiziraj(sp.Matrix([[1, p], [pb, 1]]),
               p_put=lambda t: t + 0j, dp_put=lambda t: 1 + 0j,
               theta_a=-2, theta_b=2,
               naslov='Пример 1: реалан параметар, M = [[1, p], [p̄, 1]]',
               fajl='slike/primer1.png', x_oznaka='$p$')

    # 2) Правоугаона 3×2 матрица, p на јединичној кружници.
    #    Колоне [1,1,1] и [1,p,p²] су паралелне само за p = 1 (θ = 0).
    #    A = M M^H је 3×3 -> једна тривијална нула (q = 1).
    M2 = sp.Matrix([[1, 1], [1, p], [1, p ** 2]])
    analiziraj(M2, p_put=lambda t: np.exp(1j * t), dp_put=lambda t: 1j * np.exp(1j * t),
               theta_a=-np.pi, theta_b=np.pi,
               naslov='Пример 2: правоугаона M (3×2), p = e^{jθ}',
               fajl='slike/primer2.png', x_oznaka=r'$\theta$ [rad]')

    # 3) 3×3 матрица у којој ранг пада на различитим местима за различит износ:
    #    M = [[1, 1, 0], [1, p, 0], [0, 0, p + 1]],  p = e^{jθ}
    #    det = (p − 1)(p + 1): ранг 3, пада на 2 у θ = 0 и θ = ±π.
    M3 = sp.Matrix([[1, 1, 0], [1, p, 0], [0, 0, p + 1]])
    analiziraj(M3, p_put=lambda t: np.exp(1j * t), dp_put=lambda t: 1j * np.exp(1j * t),
               theta_a=-3.0, theta_b=3.2,
               naslov='Пример 3: M = [[1,1,0],[1,p,0],[0,0,p+1]], p = e^{jθ}',
               fajl='slike/primer3.png', x_oznaka=r'$\theta$ [rad]')

    # 4) Задати директно коефицијенти: k(λ) = λ² − 4λ + |p − 1|²
    #    (полином хермитске 2×2 матрице са трагом 4 и детерминантом |p − 1|²)
    analiziraj(koeficijenti=[(p - 1) * (pb - 1), -4, 1],
